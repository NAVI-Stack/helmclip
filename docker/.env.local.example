# ==============================================================================
# Paperclip Local Workspace & Multi-LLM Environment Settings
# Copy this file to '.env' (in the project root) or keep as '.env' in docker/
# ==============================================================================

# ------------------------------------------------------------------------------
# General Settings
# ------------------------------------------------------------------------------
PAPERCLIP_PORT=3100
PAPERCLIP_DATA_DIR=../data/docker-paperclip
BETTER_AUTH_SECRET=generate-a-secure-random-hex-string-for-production
PAPERCLIP_PUBLIC_URL=http://localhost:3100

# Linux Users: set these to match your host user's UID and GID (run `id -u` and `id -g`)
# to prevent permission conflicts with mounted workspace files.
USER_UID=1000
USER_GID=1000

# ------------------------------------------------------------------------------
# LLM Provider Keys
# ------------------------------------------------------------------------------

# Claude (for @anthropic-ai/claude-code CLI via claude-local adapter)
ANTHROPIC_API_KEY=

# OpenAI & Codex (for @openai/codex CLI via codex-local adapter)
OPENAI_API_KEY=

# Gemini (for @google/gemini-cli via gemini-local adapter)
GEMINI_API_KEY=
GOOGLE_API_KEY=

# ------------------------------------------------------------------------------
# Ollama & Custom LLM Endpoints
# ------------------------------------------------------------------------------

# Ollama runs on your host machine. Docker containers can reach it using:
# http://host.docker.internal:11434
#
# To route OpenCode / Codex adapters to Ollama:
# 1. Provide an OpenAI-compatible API base URL:
#    OPENAI_BASE_URL=http://host.docker.internal:11434/v1
# 2. Provide a dummy API key (some clients require non-empty keys):
#    OPENAI_API_KEY=ollama
# 3. Configure the agent model in Paperclip (e.g. qwen2.5-coder, deepseek-coder)
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_API_BASE=http://host.docker.internal:11434
OPENAI_BASE_URL=

# ------------------------------------------------------------------------------
# Local Workspace Mounts
# ------------------------------------------------------------------------------
# Specify the absolute paths to the directories/repositories on your host machine
# that you want Paperclip to have access to. 
#
# Inside Paperclip, configure your project workspaces' CWD to map to:
# /workspaces/workspace_1, /workspaces/workspace_2
#
# Windows Paths: Use forward slashes (e.g., C:/Users/name/projects/my-app)
# Linux Paths: E.g., /home/name/projects/my-app

WORKSPACE_1_PATH=C:/Users/evirg/codespace/NAVI-Ecosystem/projects/navi
WORKSPACE_2_PATH=C:/Users/evirg/codespace/conversate
